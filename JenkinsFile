pipeline {
    agent any
    
    

    stages {
        stage('Build') {
            steps {
                // Once it clones, it will find your solution file
                sh 'dotnet restore'
                sh 'dotnet build --no-restore'
            }
            
        }
        stage('Test') {
            steps {
                // Using the specific Cobertura collector for better compatibility
                sh 'dotnet test --no-build --no-restore --collect "XPlat Code Coverage"'
            }
            post {
                always {
                    // Specific pattern to avoid the .sonarqube folder error
                    recordCoverage(tools: [[parser: 'COBERTURA', pattern: '**/TestResults/**/coverage.cobertura.xml']])
                }
            }
        }
        stage('Deliver') { 
            steps {
                sh 'dotnet publish BookingWebsite --no-restore -o published'  
            }
            post {
                success {
                    archiveArtifacts 'published/**/*' 
                }
            }
        }


    }
}